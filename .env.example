# Environment Variables for Domain Monitor
#
# NOTE: These variables apply ONLY to the local/Node path (Option A — `pnpm dev` /
# `pnpm build` / `pnpm start` with a local SQLite file).
#
# For a Cloudflare Production deployment (Option B), do NOT put secrets in a `.env`
# file. Instead use `wrangler secret put` (see README "Cloudflare Production
# Deployment (Option B)"):
#
#   openssl rand -hex 32 | pnpm exec wrangler secret put ENCRYPTION_KEY
#   openssl rand -hex 32 | pnpm exec wrangler secret put SESSION_SECRET
#
# The `.env` file is local-only and never used by the Cloudflare Worker runtime.

# Database
DATABASE_URL="./data/domain-monitor.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secrets (v0.8.0+)
# AES-256-GCM master key for encrypted notification secrets.
# 32 bytes = 64 hex characters. REQUIRED in production.
# Example: ENCRYPTION_KEY="<64 hex chars>"
# (Dev falls back to a persisted generated key when unset.)
ENCRYPTION_KEY=""

# Session secret for login session (cookie) signing. Local path only; for
# Cloudflare production set it with:  pnpm exec wrangler secret put SESSION_SECRET
# SESSION_SECRET=""

# Legacy Telegram bot token fallback (optional, kept for existing deployments).
# Preferred path: enter the token in the notification UI (getMe-verified, AES-256-GCM encrypted).
# TELEGRAM_BOT_TOKEN=""
