# Environment Variables for Domain Monitor

# Database
DATABASE_URL="./data/domain-monitor.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secrets (v0.8.0+)
# AES-256-GCM master key for encrypted notification secrets.
# 32 bytes = 64 hex characters. REQUIRED in production.
# Example: ENCRYPTION_KEY="<64 hex chars>"
# (Dev falls back to a persisted generated key when unset.)
ENCRYPTION_KEY=""

# Legacy Telegram bot token fallback (optional, kept for existing deployments).
# Preferred path: enter the token in the notification UI (getMe-verified, AES-256-GCM encrypted).
# TELEGRAM_BOT_TOKEN=""
