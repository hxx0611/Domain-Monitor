{
  "name": "domain-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, modern, self-hostable domain lifecycle monitoring platform",
  "license": "MIT",
  "author": "hxx0611",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "worker": "tsx --conditions=react-server scripts/worker.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.7",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "10.4.16",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.5",
    "postcss": "8.4.31",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.2.2"
}
